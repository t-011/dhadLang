دع مجموع = 0;
دع ع = 0;
بينما (1) {
    دع مؤقت = ع;   # a local declared before the jumps: they must pop it
    ع = ع + 1;
    اذا (ع > 10) {
        توقف;
    }
    اذا (ع % 2 == 0) {
        استمر;
    }
    مجموع = مجموع + مؤقت;
}
اطبع(مجموع);   # 0 + 2 + 4 + 6 + 8

# break only leaves the inner loop
دع خارجي = 0;
دع عدد = 0;
بينما (خارجي < 3) {
    دع داخلي = 0;
    بينما (1) {
        داخلي = داخلي + 1;
        اذا (داخلي == 4) {
            توقف;
        }
        عدد = عدد + 1;
    }
    خارجي = خارجي + 1;
}
اطبع(عدد);   # 3 * 3
